NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEON_BRANCH=main
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Trigger.dev — get from the dashboard API Keys page (DEV key starts with tr_dev_)
TRIGGER_SECRET_KEY=

NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

# Browserbase (legacy — now replaced by Browserless)
BROWSERBASE_API_KEY=

# Browserless — cloud browser for Stagehand
BROWSERLESS_API_KEY=

# LLM provider: glm | deepseek
LLM_PROVIDER=deepseek

# 智谱 (GLM) API key — get from https://open.bigmodel.cn
GLM_API_KEY=

# DeepSeek API key — get from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Resend — get from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
# The email address that workflow emails are sent from (defaults to Resend testing domain)
# Note: onboarding@resend.dev only delivers to your verified Resend account email.
# To send to any address, verify a custom domain at https://resend.com/domains.
RESEND_FROM_EMAIL=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time secret for source map upload (starts with sntrys_)
SENTRY_AUTH_TOKEN=
